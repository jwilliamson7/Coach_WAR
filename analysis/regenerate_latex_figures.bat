python analysis\create_career_distribution_figure.py --font Helvetica
if %errorlevel% neq 0 (
    echo ERROR: Failed to generate career distribution figure
    exit /b 1
)

echo.
echo ================================================================================
echo SUCCESS! Both LaTeX figures regenerated with Helvetica font
echo ================================================================================
echo.
echo Figures saved to: latex\figures\
echo   - coach_trajectories_oconnell_shula_eberflus.png
