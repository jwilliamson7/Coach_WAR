@echo off
echo ================================================================================
echo Regenerating LaTeX Figures with Helvetica Font
echo ================================================================================
echo.

cd /d C:\Personal\Coach_WAR

echo [1/2] Generating three-coach trajectory figure...
python analysis\create_trajectory_figure.py --font Helvetica
if %errorlevel% neq 0 (
    echo ERROR: Failed to generate trajectory figure
    exit /b 1
)

echo.
